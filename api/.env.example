# ==============================================================
# ENVIRONMENT VARIABLES UNTUK VERCEL & MONGODB ATLAS
# Masukkan key & value ini di Vercel Dashboard:
# Project -> Settings -> Environment Variables
# ==============================================================

# URI MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ptc_database?retryWrites=true&w=majority

# Secret Key untuk Enkripsi Token JWT Login
JWT_SECRET=kunci_rahasia_ptc_super_aman_2026_jwt_token_auth

# Domain Frontend (CORS)
CLIENT_URL=https://ptc-murni.vercel.app

# Port Server Lokal
PORT=5000
NODE_ENV=production

